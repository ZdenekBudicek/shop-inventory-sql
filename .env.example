# Copy to ignored .env and supply your own local PostgreSQL connection string.
# SHOP_DATABASE_URL=<your-PostgreSQL-connection-string>
# SHOP_USER=<your-application-username>
# SHOP_PASSWORD may be supplied externally for automation; otherwise use the hidden prompt.
# Tests require a separate disposable database:
# SHOP_TEST_DATABASE_URL=<your-disposable-test-connection-string>
